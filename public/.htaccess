<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Canonical Business Profile routing: /biz/{slug} -> /index.php?biz=$1
    RewriteRule ^biz/([a-zA-Z0-9_-]+)/?$ index.php?biz=$1 [QSA,L]
</IfModule>

# Busherian Biasharas — Public Web Root Security Headers & Routing
Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/javascript .js
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <FilesMatch "^(sw\.js|site\.webmanifest|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
</IfModule>
