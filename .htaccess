# Busherian Biasharas — Angryhosting Root .htaccess
# Blocks direct HTTP access to .env, src/, storage/, tests/, e2e/, bin/, and routes requests to public/

Options -Indexes

<FilesMatch "^(\.env|\.git|VERSION|CHANGELOG\.md|README\.md|pytest\.ini|SKILL\.md|AGENTS\.md|CLAUDE\.md|ONBOARDING\.md)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|storage|tests|e2e|bin)/ - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
