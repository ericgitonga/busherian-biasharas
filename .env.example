# Busherian Biasharas — Environment Configuration Template
# Copy to .env and fill in production values on Angryhosting. NEVER commit .env.

APP_ENV=production
APP_URL=https://www.busherianbiasharas.com

# Database (Angryhosting MySQL or local sqlite for dev/CI)
# Production fails closed (HTTP 503) if MySQL is unreachable; never falls back to SQLite (#169).
DB_DRIVER=mysql
DB_DRIVER_FALLBACK=none
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name_here
DB_USER=your_db_user_here
DB_PASS=your_db_password_here
DB_SQLITE_PATH=storage/busherian_biasharas.sqlite

# Cryptographic Secrets (MUST be replaced with 64-char hex strings in production)
APP_HMAC_SECRET=replace_with_64_char_random_hex_secret_for_signed_tokens
IP_HASH_SECRET=replace_with_64_char_random_hex_secret_for_dpa_ip_hashing
CSRF_SECRET=replace_with_64_char_random_hex_secret_for_csrf_protection

# Admin Notification & Auth
ADMIN_EMAIL=admin@busherianbiasharas.com
ADMIN_PASSWORD_HASH=

# Outbound Email Isolation ("yes" in local/staging/CI, "no" in production)
SIMULATE_EMAILS=no
