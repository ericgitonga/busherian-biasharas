# Busherian Biasharas — Environment Configuration Template
# Copy to .env and fill in production values on Angryhosting. NEVER commit .env.

APP_ENV=production
APP_URL=https://www.busherianbiasharas.com

# Database (Angryhosting MySQL or local sqlite for dev/CI)
# Production fails closed (HTTP 503) if MySQL is unreachable; never falls back to SQLite (#169).
DB_DRIVER=mysql
DB_DRIVER_FALLBACK=none
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_db_name_here
DB_USER=your_db_user_here
DB_PASS=your_db_password_here
DB_SQLITE_PATH=storage/busherian_biasharas.sqlite

# Cryptographic Secrets (MUST be replaced with 64-char hex strings in production)
APP_HMAC_SECRET=replace_with_64_char_random_hex_secret_for_signed_tokens
IP_HASH_SECRET=replace_with_64_char_random_hex_secret_for_dpa_ip_hashing
CSRF_SECRET=replace_with_64_char_random_hex_secret_for_csrf_protection
# Scheduled WebCron Secret (defaults to APP_HMAC_SECRET if omitted)
CRON_SECRET=replace_with_64_char_random_hex_secret_for_scheduled_webcron

# Admin Notification & Auth
ADMIN_EMAIL=gitonga@gmail.com
ADMIN_PASSWORD_HASH=

# Outbound Email Isolation ("yes" in local/staging/CI, "no" in production)
SIMULATE_EMAILS=no

# Schema Migration Control (#220): Disable web-request DDL when running `php bin/migrate-and-seed.php` via CLI/deploy
BBIZ_DISABLE_WEB_AUTO_MIGRATE=true

# Authenticated TLS SMTP Transport (#250, #356, #461: TLS required in production; mx1.angryhosting.com dedicated relay)
SMTP_HOST=mx1.angryhosting.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_TLS_PEER_NAME=mx1.angryhosting.com
# SMTP credentials (both SMTP_USER / SMTP_USERNAME and SMTP_PASS / SMTP_PASSWORD supported)
SMTP_USER=noreply@busherianbiasharas.com
SMTP_PASS=
SMTP_USERNAME=noreply@busherianbiasharas.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@busherianbiasharas.com
SMTP_FROM_NAME="Busherian Biasharas"
SMTP_VERIFY_TLS_PEER=yes
SMTP_DISABLE_MAIL_FALLBACK=yes
ALLOW_PHP_MAIL_FALLBACK=no

# Google SSO OAuth 2.0 Credentials (#466)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
